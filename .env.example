# ATLAS Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_URL=http://localhost:5173

# ============================================
# SUPABASE
# ============================================
VITE_SUPABASE_URL=https://rkonxtxkmmmorskygovi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_0bT56mazZtx5wf5ooL_obQ_ClkcZ-Xq

# Server-side only (not prefixed with VITE_)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_Vx_kCuh0dWIG5tloRqaiRg_wsexQzJjo

# ============================================
# DATABASE (if direct connection needed)
# ============================================
# Usually not required - Supabase client handles this
# DATABASE_URL=postgresql://user:password@host:5432/atlas

# ============================================
# CESIUM
# ============================================
VITE_CESIUM_ION_ACCESS_TOKEN=your-cesium-ion-token-here

# ============================================
# AI / LLM PROVIDERS
# ============================================
# OpenAI (if used)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (if used)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Other providers as needed
# GOOGLE_AI_API_KEY=
# COHERE_API_KEY=

# ============================================
# EXTERNAL GEOSPATIAL APIs
# ============================================
# OpenWeatherMap (if weather data needed)
# OPENWEATHER_API_KEY=

# NASA Earthdata (if using NASA datasets)
# NASA_EARTHDATA_USERNAME=
# NASA_EARTHDATA_PASSWORD=

# Copernicus (if using Copernicus data)
# COPERNICUS_USERNAME=
# COPERNICUS_PASSWORD=

# ============================================
# STORAGE & CDN
# ============================================
# Supabase Storage handles most of this
# Add external CDN config if needed

# ============================================
# ANALYTICS & MONITORING
# ============================================
# VITE_ANALYTICS_ID=
# SENTRY_DSN=
# VITE_POSTHOG_KEY=

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_3D_TERRAIN=true
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# ============================================
# DEVELOPMENT
# ============================================
VITE_API_BASE_URL=http://localhost:5173
VITE_ENABLE_DEBUG_LOGGING=true
VITE_MOCK_GEOSPATIAL_DATA=false


# ============================================
# CESIUM
# ============================================
VITE_CESIUM_ION_ACCESS_TOKEN=your-cesium-ion-token-here

# ============================================
# AI / LLM PROVIDERS
# ============================================
# Add your preferred AI provider key
OPENAI_API_KEY=sk-your-key-here
# or ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_3D_TERRAIN=true
